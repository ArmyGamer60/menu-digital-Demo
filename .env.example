# ── Base de datos (obligatoria en producción) ──
# Postgres. En Vercel: Storage → Create Database → Neon (o Supabase); la variable se agrega sola.
# Se acepta DATABASE_URL o POSTGRES_URL. Las tablas se crean solas en la primera petición.
# En desarrollo (npm run dev) puede omitirse: se usa una base local en ./.data/pglite.
DATABASE_URL=

# ── Sesión del panel ──
# Clave para firmar la cookie de sesión (32+ caracteres aleatorios). Recomendada en producción.
SESSION_SECRET=

# Contraseña para crear la PRIMERA cuenta (superadmin) cuando aún no hay usuarios:
# entra a /admin/login con tu correo y esta contraseña. Si falta SESSION_SECRET, también firma la cookie.
# En desarrollo puede omitirse y la primera cuenta se crea con cualquier contraseña
# (p. ej. admin@menu.test / dev-password-123).
ADMIN_PASSWORD=

# ── Dominios ──
# Hosts propios de la app, separados por coma (además de localhost y *.vercel.app).
# Cualquier otro host se trata como dominio propio de un negocio. Ej: menudigital.mx,www.menudigital.mx
APP_HOSTS=

# URL principal de la app: a ella se redirige /admin cuando alguien entra desde el dominio de un negocio.
# En Vercel no hace falta (se usa VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=

# Slug del menú que abre la raíz "/" (por defecto, molienda).
DEFAULT_MENU_SLUG=
