# Contraseña del panel /admin. Obligatoria en producción: sin ella el panel queda deshabilitado.
# En desarrollo (npm run dev) puede omitirse y se acepta cualquier contraseña.
ADMIN_PASSWORD=

# Opcional: clave para firmar la cookie de sesión (32+ caracteres aleatorios).
# Si falta, se deriva de ADMIN_PASSWORD (cambiar la contraseña cierra todas las sesiones).
ADMIN_SESSION_SECRET=
